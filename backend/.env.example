PORT=4000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional. When set, projects are persisted to Postgres (Supabase-ready).
# When unset, an in-memory store is used so the dev server still boots.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/labpilot

# OpenAI is optional. When unset or failing, LabPilot uses deterministic fallback agents.
# OPENAI_API_KEY=sk-...
OPENAI_HIGH_MODEL=gpt-5.5
OPENAI_MEDIUM_MODEL=gpt-5.4-mini
OPENAI_SMALL_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RESEARCH_STEP_TIMEOUT_MS=3000

# Supabase is optional. Storage uses the service role key server-side only.
# SUPABASE_URL=https://example.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_STORAGE_BUCKET=labpilot-files

# OpenAlex is the default literature provider. API keys are free and improve quota.
# OPENALEX_ENABLED=true
# OPENALEX_API_KEY=...
# OPENALEX_MAILTO=you@example.com
# OPENALEX_MAX_RESULTS=24
# OPENALEX_MAX_QUERIES=3
# OPENALEX_TIMEOUT_MS=8000

# Optional normalized research provider endpoint used if OpenAlex is disabled or unavailable.
# GENERIC_RESEARCH_API_URL=https://example.com/search
# GENERIC_RESEARCH_API_KEY=...

# How long mocked research / generation calls take, in ms.
# Defaults to 0. Set to 10000 locally if you want to demo the loading screen.
MOCK_LATENCY_MS=0
